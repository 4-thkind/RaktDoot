# Copy to .env (repo root). Every key is optional: with none set, the app runs in
# demo mode (sample eRaktKosh stock, mock WhatsApp with the web simulator, SQLite).

# --- TinyFish (live eRaktKosh stock) ---
TINYFISH_API_KEY=
# auto | live | demo
TINYFISH_MODE=auto
ERAKTKOSH_STOCK_URL=https://eraktkosh.mohfw.gov.in/BLDAHIMS/bloodbank/stockAvailability.cnt
ERAKTKOSH_COMPONENT=Packed Red Blood Cells
STOCK_CACHE_TTL_MIN=15
STOCK_TIMEOUT_S=90
# exit country for TinyFish runs on eRaktKosh (any ISO alpha-2 code); "off" = no proxy
TINYFISH_PROXY_COUNTRY=IN
# replay the learned route on the TinyFish Browser API before sending the Agent
TINYFISH_REPLAY_ENABLED=true
# every Nth replay is cross-checked by an Agent run in the background (0 = never)
TINYFISH_VERIFY_EVERY=20
# public https URL of /webhooks/tinyfish?key=<TINYFISH_WEBHOOK_SECRET> for batch runs and monitors; empty = off
TINYFISH_WEBHOOK_URL=
TINYFISH_WEBHOOK_SECRET=
# hours between automatic district sweeps (TinyFish run-batch); 0 = only from /admin
STOCK_SWEEP_HOURS=0
# state/district pairs to sweep, comma separated
STOCK_SWEEP_DISTRICTS=

# --- WhatsApp ---
# cloud | twilio | mock
WHATSAPP_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=raktdoot-verify
# verifies X-Hub-Signature-256 on the webhook
WHATSAPP_APP_SECRET=
# digits only, used for the wa.me JOIN link
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_TEMPLATE_LANG=en
# only if WHATSAPP_MODE=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# exact public URL of /webhooks/twilio
TWILIO_WEBHOOK_URL=

# --- LLM (any OpenAI-compatible endpoint) for free-text replies; rules are used without it ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# vision-capable model on the same endpoint, for requisition slips and donor cards
VISION_MODEL=gpt-4o-mini
# optional embedding model for the family guide (empty = BM25 retrieval only)
EMBEDDING_MODEL=

# --- Speech to text for WhatsApp voice notes ---
# auto | sarvam | openai | local | demo   (auto: sarvam if STT_API_KEY, else Whisper via LLM_API_KEY, else local Whisper (in Docker, no key), else demo)
STT_PROVIDER=auto
STT_API_KEY=
# e.g. saaras:v3 (Sarvam), whisper-1 (OpenAI), or base / small (local Whisper; default base)
STT_MODEL=
# voice replies (text to speech): auto | sarvam | edge | openai | off
# auto = Sarvam if STT_API_KEY is set, else free Microsoft Edge neural voices (needs internet), else off
TTS_PROVIDER=auto
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
# public URL of this API (voice-reply links for Twilio)
PUBLIC_API_BASE=http://localhost:8000
# camp sign-up portal the registration automation fills; empty = the built-in MOCK portal (synthetic data)
CAMP_PORTAL_URL=
# keep uploaded photos for debugging (default: read, then drop)
KEEP_UPLOADS=false

# --- AI features ---
FORECAST_ENABLED=true
SHORTAGE_THRESHOLD_UNITS=5
# start pre-emptive donor drives automatically when risk >= 0.7 (otherwise from /radar)
AUTO_DRIVES=false
# LLM dispatcher picks the next step from a fixed safe action set; rules decide without a key
DISPATCH_AGENT_ENABLED=true
MAX_ALERTS_PER_REQUEST=60
MAX_ALERTS_PER_REQUEST_PER_HOUR=30
BANDIT_ENABLED=true
# camp-placement KMeans on Intel Extension for Scikit-learn (pip install -r backend/requirements-extras.txt)
USE_INTEL_SKLEARN=false
RECURRING_REMINDER_DAYS=3

# --- App ---
# empty = SQLite file in backend/
DATABASE_URL=
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ADMIN_TOKEN=change-me
# nominatim | off
GEOCODER=nominatim
APP_TIMEZONE=Asia/Kolkata

# --- Dispatch ---
DISPATCH_WAVE_SIZE=10
DISPATCH_WAVE_INTERVAL_MIN=5
DISPATCH_RADII_KM=5,10,25,40
MAX_OPEN_REQUESTS_PER_PHONE=3
REQUEST_TTL_HOURS=24
# false for a late-night demo
RESPECT_QUIET_HOURS=true

# --- Frontend ---
# empty = the web app proxies /api to the backend on the same origin (needed for the phone tunnel)
NEXT_PUBLIC_API_BASE=

# Telegram bot (the `telegram` service in docker-compose). Get both from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
